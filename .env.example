# Cybernet Stock Tracker — environment template.
# Copy to .env (local dev) and set real values. Keep secrets out of git.
# Loaded by Next.js automatically and by the Prisma CLI via prisma.config.ts.

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string.
#  - Local (non-Docker) dev:    host 127.0.0.1
#  - Docker Compose (app):      host "db" (the Postgres service name)
# The user/password/db below must match docker-compose.yml's Postgres settings.
DATABASE_URL="postgresql://stocktracker:stocktracker@127.0.0.1:5432/stocktracker?schema=public"

# Used by docker-compose.yml to provision the Postgres container.
POSTGRES_USER=stocktracker
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=stocktracker

# --- Auth ---------------------------------------------------------------------
# v0.1: no-password user switcher resolving to a seeded user (no real login).
# Local/LAN only — do NOT expose the app externally while this is true.
AUTH_STUB_ENABLED=true
#
# v1 (Entra ID SSO via NextAuth/Auth.js) — uncomment and fill when swapping the
# stub. The "current user" helper is the single place that changes.
# AUTH_STUB_ENABLED=false
# AUTH_SECRET=generate-a-long-random-string
# AUTH_MICROSOFT_ENTRA_ID_ID=your-app-registration-client-id
# AUTH_MICROSOFT_ENTRA_ID_SECRET=your-app-registration-client-secret
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# NEXTAUTH_URL=https://stock.example.co.uk

# --- Image storage ------------------------------------------------------------
# "local" stores files on disk outside the web root. Swap for "minio" later
# without changing callers (see src/lib/storage).
STORAGE_DRIVER=local
# Where the local driver writes images. Under Docker this is a mounted volume.
UPLOAD_DIR=./uploads
# Max image size in bytes (15 MB). Must stay below the Server Actions
# bodySizeLimit in next.config.ts (currently 30 MB) so uploads reach validation.
MAX_UPLOAD_BYTES=15728640
